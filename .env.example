# Solana / program
SOLANA_RPC_URL=
ODDLOT_PROGRAM_ID=
TEST_USDC_MINT=

# Keypair paths — keep files OUTSIDE this repo
ADMIN_KEYPAIR=
KEEPER_KEYPAIR=
FAUCET_KEYPAIR=

# Services
PRICER_URL=
KEEPER_URL=
DATABASE_URL=sqlite:///./pricer/oddlot.db

# QuickNode
QUICKNODE_API_KEY=
QUICKNODE_STREAM_TOKEN=

# Pyth Hermes (Equity.US.VOO/USD). Required for year-end buy/settle + pricer spot.
# Demo replay does not use it. Also set on the Next app (app/.env.local) and pricer host.
PYTH_API_KEY=

# Gemini (sandbox orders only; market data needs no key)
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Next.js (public)
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_PRICER_URL=
NEXT_PUBLIC_KEEPER_URL=

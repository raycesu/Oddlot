{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddlot.local/schemas/api/simulation.schema.json",
  "title": "GET /simulation",
  "type": "object",
  "additionalProperties": false,
  "required": ["asof", "spot", "paths", "strategies"],
  "properties": {
    "asof": { "type": "string", "format": "date-time" },
    "spot": { "type": "string" },
    "paths": { "type": "integer", "const": 1000 },
    "strategies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mean_pnl", "p05", "p50", "p95"],
        "properties": {
          "id": { "enum": ["unhedged", "delta", "lots_delta", "lots_gemini"] },
          "mean_pnl": { "type": "string" },
          "p05": { "type": "string" },
          "p50": { "type": "string" },
          "p95": { "type": "string" }
        }
      }
    }
  }
}
